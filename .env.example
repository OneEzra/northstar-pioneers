# Organizer email sign-in (Netlify functions in netlify/functions).
# In production set these in Netlify > Project configuration > Environment variables,
# scoped to Functions and marked secret. For local testing copy this to .env.local.

# Organizer Nostr private key (nsec1... or 64-char hex). The server signs events with it,
# so its public key must be in NSP_ADMIN_PUBKEYS (src/lib/nspNostr.ts).
NSP_SIGNING_KEY=

# Emails allowed to sign in, comma-separated. Add or remove people here, then redeploy.
NSP_ADMIN_EMAILS=

# Postmark server token, used to email sign-in codes. Leave empty locally and the
# code prints in the dev server's terminal instead.
POSTMARK_SERVER_TOKEN=

# Optional. Defaults to "Key for Northstar Pioneers <keys@northstarpioneers.com>" (address must be on the verified Postmark domain).
NSP_LOGIN_FROM=

# Local testing only: makes the admin page trust this public key as organizer.
# VITE_NSP_ADMIN_PUBKEY=
